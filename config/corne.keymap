#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt { tapping-term-ms = <100>; };

&mt { tapping-term-ms = <100>; };

/ {
    combos {
        compatible = "zmk,combos";

        caps_lock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <24 35>;
        };
    };

    behaviors {
        caps_lock: caps_lock {
            compatible = "zmk,behavior-tap-dance";
            label = "CAPS_LOCK";
            #binding-cells = <0>;
            bindings = <&none>, <&kp CAPSLOCK>;

            tapping-term-ms = <200>;
        };

        shift_backspace: shift_backspace {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFT_BACKSPACE";
            #binding-cells = <0>;
            bindings = <&mt LEFT_SHIFT BACKSPACE>, <&kp BACKSPACE>;

            tapping-term-ms = <100>;
        };

        space_nav: space_nav {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACE_NAV";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main {
            bindings = <
&kp TAB     &kp Q  &kp W  &kp E                        &kp R             &kp T                &kp Y        &kp U               &kp I                            &kp O    &kp P          &kp BACKSLASH
&kp LCTRL   &kp A  &kp S  &kp D                        &kp F             &kp G                &kp H        &kp J               &kp K                            &kp L    &kp SEMICOLON  &kp SQT
&caps_lock  &kp Z  &kp X  &kp C                        &kp V             &kp B                &kp N        &kp M               &kp COMMA                        &kp DOT  &kp FSLH       &mo 5
                          &mt LS(LA(LCTRL)) LG(LC(M))  &shift_backspace  &mt LEFT_META ESC    &lt 2 ENTER  &space_nav 1 SPACE  &mt LEFT_ALT LS(LC(LA(INSERT)))
            >;
        };

        numsym {
            bindings = <
&trans  &kp LBKT   &kp N7  &kp N8   &kp N9  &kp RBKT     &trans  &trans          &trans     &trans        &trans        &trans
&trans  &kp SEMI   &kp N4  &kp N5   &kp N6  &kp EQUAL    &trans  &kp LEFT_SHIFT  &kp LCTRL  &kp LEFT_ALT  &kp LEFT_WIN  &trans
&trans  &kp GRAVE  &kp N1  &kp N2   &kp N3  &kp BSLH     &trans  &trans          &trans     &trans        &trans        &trans
                           &kp DOT  &kp N0  &kp MINUS    &trans  &trans          &trans
            >;
        };

        nav {
            bindings = <
&trans  &mkp RCLK  &trans          &mmv MOVE_UP    &trans           &mkp MCLK    &kp SYSREQ  &kp HOME        &trans        &kp END             &trans  &trans
&trans  &mkp LCLK  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans       &kp LEFT    &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW     &trans  &trans
&trans  &trans     &kp LCTRL       &kp LSHIFT      &kp LEFT_ALT     &trans       &kp DEL     &kp PAGE_DOWN   &kp PG_UP     &kp K_CONTEXT_MENU  &trans  &trans
                                   &trans          &trans           &trans       &trans      &trans          &trans
            >;
        };

        Fun {
            bindings = <
&trans  &kp F12  &kp F7  &kp F8  &kp F9     &kp PRINTSCREEN    &trans  &trans     &trans     &trans    &trans    &trans
&trans  &kp F11  &kp F4  &kp F5  &kp F6     &trans             &trans  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &trans
&trans  &kp F10  &kp F1  &kp F2  &kp F3     &trans             &trans  &trans     &trans     &trans    &trans    &trans
                         &trans  &kp SPACE  &kp TAB            &trans  &trans     &trans
            >;
        };

        game {
            bindings = <
&trans  &kp ESCAPE  &kp Q     &kp W   &kp E      &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LSHFT   &kp A     &kp S   &kp D      &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans      &kp LEFT  &trans  &kp RIGHT  &trans       &trans  &trans  &trans  &trans  &trans  &trans
                              &kp C   &kp SPACE  &kp LCTRL    &trans  &trans  &trans
            >;
        };

        firmware {
            bindings = <
&trans  &trans        &trans        &trans        &trans        &trans          &sys_reset      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans          &trans          &trans  &trans  &trans  &trans  &trans
                                    &trans        &bootloader   &bt BT_CLR      &bt BT_CLR_ALL  &trans  &trans
            >;
        };
    };
};
