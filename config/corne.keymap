#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt { tapping-term-ms = <100>; };

&mt { tapping-term-ms = <100>; };

/ {
    combos {
        compatible = "zmk,combos";

        caps_lock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <24 35>;
        };
    };

    behaviors {
        caps_lock: caps_lock {
            compatible = "zmk,behavior-tap-dance";
            label = "CAPS_LOCK";
            #binding-cells = <0>;
            bindings = <&none>, <&kp CAPSLOCK>;

            tapping-term-ms = <200>;
        };

        layer_backspace: layer_backspace {
            compatible = "zmk,behavior-tap-dance";
            label = "LAYER_BACKSPACE";
            #binding-cells = <0>;
            bindings = <&lt 2 BACKSPACE>, <&kp BACKSPACE>;

            tapping-term-ms = <100>;
        };

        space_nav: space_nav {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACE_NAV";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main {
            bindings = <
&kp TAB           &kp Q  &kp W  &kp E             &kp R        &kp T                 &kp Y                  &kp U           &kp I            &kp O    &kp P          &kp BACKSLASH
&kp LEFT_CONTROL  &kp A  &kp S  &kp D             &kp F        &kp G                 &kp H                  &kp J           &kp K            &kp L    &kp SEMICOLON  &kp SQT
&kp LEFT_WIN      &kp Z  &kp X  &kp C             &kp V        &kp B                 &kp N                  &kp M           &kp COMMA        &kp DOT  &kp FSLH       &tog 4
                                &layer_backspace  &lt 1 SPACE  &mt LEFT_ALT ENTER    &mt LEFT_SHIFT ESCAPE  &lt 3 C_VOL_DN  &kp C_VOLUME_UP
            >;
        };

        numsym {
            bindings = <
&kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp N7  &kp N8  &kp N9  &kp N0       &trans  &trans          &trans     &trans        &trans        &trans
&kp PERIOD        &kp SEMI           &kp N4  &kp N5  &kp N6  &kp EQUAL    &trans  &kp LEFT_SHIFT  &kp LCTRL  &kp LEFT_ALT  &kp LEFT_WIN  &trans
&kp ENTER         &kp GRAVE          &kp N1  &kp N2  &kp N3  &kp BSLH     &trans  &trans          &trans     &trans        &trans        &trans
                                             &trans  &trans  &trans       &trans  &trans          &trans
            >;
        };

        Fun {
            bindings = <
&kp TAB  &kp F12  &kp F7  &kp F8  &kp F9     &kp PRINTSCREEN    &trans  &trans     &trans     &trans    &trans    &mo 5
&trans   &kp F11  &kp F4  &kp F5  &kp F6     &kp LG(LS(C))      &trans  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &trans
&trans   &kp F10  &kp F1  &kp F2  &kp F3     &trans             &trans  &trans     &trans     &trans    &trans    &trans
                          &trans  &kp SPACE  &trans             &trans  &trans     &trans
            >;
        };

        nav {
            bindings = <
&trans  &mkp RCLK  &trans          &mmv MOVE_UP    &trans           &mkp MCLK    &kp INSERT  &kp UP_ARROW    &kp DELETE       &kp PG_UP      &trans  &trans
&trans  &mkp LCLK  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans       &kp LEFT    &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp PAGE_DOWN  &trans  &trans
&trans  &trans     &kp LCTRL       &kp LSHIFT      &kp LEFT_ALT     &trans       &kp HOME    &kp PAGE_DOWN   &kp END          &trans         &trans  &trans
                                   &trans          &trans           &trans       &trans      &trans          &trans
            >;
        };

        game {
            bindings = <
&kp TAB       &kp ESCAPE  &kp Q     &kp W   &kp E      &kp NUMBER_1    &trans  &trans  &trans  &trans  &trans  &trans
&kp NUMBER_4  &kp LSHFT   &kp A     &kp S   &kp D      &kp NUMBER_2    &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans      &kp LEFT  &trans  &kp RIGHT  &kp NUMBER_3    &trans  &trans  &trans  &trans  &trans  &trans
                                    &kp C   &kp SPACE  &kp LCTRL       &trans  &trans  &trans
            >;
        };

        firmware {
            bindings = <
&trans  &trans        &trans        &trans        &trans        &trans          &sys_reset      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans          &trans          &trans  &trans  &trans  &trans  &to 0
                                    &trans        &bootloader   &bt BT_CLR      &bt BT_CLR_ALL  &trans  &trans
            >;
        };
    };
};
